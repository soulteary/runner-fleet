# 示例配置。使用前请复制为 config/config.yaml 后按需修改。
#   mkdir -p config && cp config.yaml.example config/config.yaml
# 详细字段说明见 docs/config.md
#
# Docker / docker-compose：请将 runners.base_path 改为 /app/runners（与镜像内卷挂载一致）
# 全容器部署时可通过 .env 设置 CONTAINER_MODE、VOLUME_HOST_PATH、JOB_DOCKER_BACKEND 等覆盖下列注释项，无需在本文件中取消注释或填写。

server:
    port: 8080
    addr: 0.0.0.0
runners:
    # 本地运行：./runners；Docker 部署：/app/runners
    base_path: ./runners
    items: []   # 预置 Runner 列表，也可通过 Web 界面添加
    # 容器模式下可按 Runner 覆盖镜像与 Job Docker 后端（留空回落下面的全局配置），
    # 便于一台机器上不同项目使用不同工具链：
    # items:
    #   - name: droiddesk
    #     target_type: repo
    #     target: soulteary/droiddesk
    #     labels: [droiddesk]
    #     container_image: your-registry/droiddesk-runner:1   # 预装 Flutter + Android SDK
    #     job_docker_backend: none                            # 该项目不需要 Job 内 Docker

    # 容器模式：每个 Runner 运行在独立容器中，Manager 通过宿主机 Docker（socket）启停，并与 Runner 容器同网络
    # 启用后 Manager 必须使用宿主机 docker（勿设 DOCKER_HOST=tcp://runner-dind:2375）
    # container_mode: true
    # container_image 不填则按 FLEET_IMAGE_TAG 或默认 v1.3.0 生成；示例：ghcr.io/soulteary/runner-fleet:v1.3.0-runner
    # container_image: ghcr.io/soulteary/runner-fleet:v1.3.0-runner
    # container_network: runner-net
    # agent_port: 8081
    # Job 内 Docker 后端：dind（DinD 服务）、host-socket（挂载宿主机 socket）、none（不提供）
    # job_docker_backend: dind   # 默认 dind；可选 host-socket、none
    # dind_host: runner-dind     # 仅 job_docker_backend=dind 时有效
    # docker_gid: 999            # 仅 job_docker_backend=host-socket 时有效：Runner 容器追加的 docker 组 GID，
    #                            # 使容器内 Job 能访问挂载的 docker.sock。留空/0 表示自动探测 docker.sock 所属组
    # volume_host_path: /absolute/path/on/host/to/runners   # Manager 在容器内时必填，为宿主机上 runners 目录的绝对路径
    # 容器模式下 Runner 容器的资源上限，留空不限制。强烈建议设置：
    # 不限制时单个失控 Job（如 Gradle daemon）可耗尽整机内存，连带拖垮 Manager
    # resources:
    #     cpus: "2"          # --cpus
    #     memory: 4g         # --memory
    #     memory_swap: 4g    # --memory-swap，需同时设置 memory；等于 memory 表示禁用 swap
    #     pids_limit: 512    # --pids-limit，-1 表示不限
    # 修改后对已存在的容器同样生效（启停时通过 docker update 施加）；清除限制需重建容器
