# 多容器部署：每个 Runner 一个容器，共享镜像与工具链缓存，隔离构建缓存
#
# 用法：cp .env.example .env，改掉两处「← 必改」，然后按 README.md 的步骤启动。

# ===================== Manager =====================
MANAGER_IMAGE=ghcr.io/soulteary/runner-fleet:v1.5.0

# 宿主机监听地址:端口。容器内监听端口由下面的 SERVER_PORT 决定，compose 会把两者对应起来，
# 所以这里填 8080、9000 或 127.0.0.1:8090 都可以。只想本机访问就保留 127.0.0.1 前缀。
MANAGER_PORT=127.0.0.1:8090
SERVER_PORT=8080
SERVER_ADDR=0.0.0.0

BASIC_AUTH_USER=admin
# 留空则不鉴权（GET /health 任何时候都免鉴权）。暴露到公网时必须设置。
BASIC_AUTH_PASSWORD=

# ============ 容器模式：构建缓存隔离的来源 ============
# 每个 Runner 一个容器，容器内 HOME=/runner，即宿主机 ${VOLUME_HOST_PATH}/<Runner 名>，
# 于是 _work 与 ~/.gradle、~/.m2、~/.npm、~/.cache 都落在各自目录，Runner 之间互不影响。
CONTAINER_MODE=true
RUNNERS_BASE_PATH=/app/runners
CONTAINER_NETWORK=runner-net

# ← 必改：宿主机上 runners 目录的绝对路径，在本目录执行 `realpath runners` 取值。
# 填错不会报错，只会让 Runner 容器挂到一个空目录、状态一直停在 new。
VOLUME_HOST_PATH=/absolute/path/to/examples/deploy/fleet/runners

# ========== 镜像缓存共享：所有 Job 共用宿主机 daemon ==========
# 镜像层与 BuildKit 缓存本来就是 daemon 级别的，指向同一个 daemon 就是共享，无需额外配置。
# 注意 host-socket 只能在 CONTAINER_MODE=true 时使用（非容器模式下配置校验强制为 dind）。
# 代价：Job 拿到的是宿主机 daemon 的完全控制权，仅在信任仓库与 workflow 时使用；
# 需要更强隔离就改成 JOB_DOCKER_BACKEND=dind 并 `docker compose --profile dind up -d`；
# 已存在的 Runner 容器沿用创建时的后端，Manager 会认出这种不一致：已停止的容器在点「启动」时
# 自动重建，正在运行的则标出「配置已变更」，由你点「重建容器」决定何时中断。
JOB_DOCKER_BACKEND=host-socket

# ← 必核对：getent group docker | cut -d: -f3
# 两个用途：compose 的 group_add（Manager 访问宿主机 socket）、以及 Manager 给 Runner 容器
# 追加 --group-add（Job 内访问 socket）。留空时 compose 回落到 999，Manager 侧自动探测。
DOCKER_GID=999

# ====== 工具链 / Action 缓存共享：自建 Runner 镜像 ======
# 由 `docker compose --profile build build runner-image` 用 Dockerfile.runner-cached 构建。
# 镜像里已用 ENV 写好 RUNNER_TOOL_CACHE / ACTIONS_RUNNER_ACTION_ARCHIVE_CACHE，
# 不需要再给每个 Runner 目录单独放 .env。
RUNNER_IMAGE=local/runner-fleet-cached:v1.5.0-runner
RUNNER_BASE_IMAGE=ghcr.io/soulteary/runner-fleet:v1.5.0-runner
NODE_VERSION=22.14.0

# 不要设置 DOCKER_HOST：容器模式下 Manager 必须用宿主机 unix socket 创建/启停 Runner 容器，
# 指向 DinD 时点「启动」会直接报错。
