# 单容器部署：Runner 进程跑在 Manager 容器内（默认模式，container_mode=false）
#
# 用法：cp .env.example .env，按需修改，然后 docker compose up -d
# 不想用 compose 就直接看 run.sh（同一套参数的 docker run 版本）。

MANAGER_IMAGE=ghcr.io/soulteary/runner-fleet:v1.5.0

# 宿主机监听地址:端口。容器内监听端口由 SERVER_PORT 决定，compose 会把两者对应起来。
MANAGER_PORT=127.0.0.1:8080
SERVER_PORT=8080
SERVER_ADDR=0.0.0.0

BASIC_AUTH_USER=admin
# 留空则不鉴权（GET /health 任何时候都免鉴权）。暴露到公网时必须设置。
BASIC_AUTH_PASSWORD=

RUNNERS_BASE_PATH=/app/runners

# Job 里要用 docker 时需要：挂进容器的宿主机 docker.sock 的属组
#   getent group docker | cut -d: -f3
# 容器以 UID 1001 运行，不在该组里时 Job 中的 docker 会报 permission denied。
DOCKER_GID=999

# Job 内 Docker 后端：
#   默认（本文件不设 DOCKER_HOST）走宿主机 socket —— 所有 Job 共用宿主机 daemon，
#   镜像层与 BuildKit 缓存天然共享，代价是 Job 拿到宿主机 daemon 的完全控制权。
#   想改用 DinD：取消下一行注释，并以 docker compose --profile dind up -d 启动。
# DOCKER_HOST=tcp://runner-dind:2375
